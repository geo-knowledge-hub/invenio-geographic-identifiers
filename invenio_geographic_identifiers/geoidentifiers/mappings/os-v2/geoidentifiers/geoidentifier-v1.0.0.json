{
  "settings": {
    "analysis": {
      "analyzer": {
        "geoidentifier_name": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "$schema": {
        "type": "keyword",
        "index": "false"
      },
      "created": {
        "type": "date"
      },
      "updated": {
        "type": "date"
      },
      "indexed_at": {
        "type": "date"
      },
      "uuid": {
        "type": "keyword"
      },
      "version_id": {
        "type": "integer"
      },
      "id": {
        "type": "keyword"
      },
      "scheme": {
        "type": "keyword"
      },
      "name": {
        "type": "text",
        "analyzer": "geoidentifier_name",
        "copy_to": "name_sort",
        "fields": {
          "suggest": {
            "type": "search_as_you_type",
            "analyzer": "geoidentifier_name"
          }
        }
      },
      "name_sort": {
        "type": "keyword"
      },
      "locations": {
        "properties": {
          "geometry": {
            "type": "geo_shape"
          }
        }
      },
      "extras": {
        "properties": {
          "ascii_name": {
            "type": "text",
            "fields": {
              "suggest": {
                "type": "search_as_you_type",
                "analyzer": "geoidentifier_name"
              }
            },
            "analyzer": "geoidentifier_name"
          },
          "alternate_names": {
            "type": "text",
            "fields": {
              "suggest": {
                "type": "search_as_you_type",
                "analyzer": "geoidentifier_name"
              }
            },
            "analyzer": "geoidentifier_name"
          },
          "country": {
            "properties": {
              "code": {
                "type": "keyword"
              },
              "name": {
                "type": "text",
                "fields": {
                  "keyword": {
                    "type": "keyword"
                  }
                },
                "analyzer": "geoidentifier_name"
              },
              "official_name": {
                "type": "text"
              }
            }
          },
          "admin": {
            "properties": {
              "level1": {
                "properties": {
                  "code": {
                    "type": "keyword"
                  },
                  "name": {
                    "type": "text",
                    "fields": {
                      "keyword": {
                        "type": "keyword"
                      }
                    },
                    "analyzer": "geoidentifier_name"
                  }
                }
              },
              "level2": {
                "properties": {
                  "code": {
                    "type": "keyword"
                  },
                  "name": {
                    "type": "text"
                  }
                }
              },
              "level3": {
                "properties": {
                  "code": {
                    "type": "keyword"
                  },
                  "name": {
                    "type": "text"
                  }
                }
              },
              "level4": {
                "properties": {
                  "code": {
                    "type": "keyword"
                  },
                  "name": {
                    "type": "text"
                  }
                }
              }
            }
          },
          "feature": {
            "properties": {
              "class": {
                "type": "keyword"
              },
              "class_name": {
                "type": "text"
              },
              "code": {
                "type": "keyword"
              },
              "name": {
                "type": "text"
              }
            }
          },
          "population": {
            "type": "long"
          },
          "elevation": {
            "type": "integer"
          },
          "dem": {
            "type": "integer"
          },
          "timezone": {
            "type": "keyword"
          },
          "modified": {
            "type": "date"
          }
        }
      },
      "pid": {
        "type": "object",
        "properties": {
          "pk": {
            "type": "integer"
          },
          "pid_type": {
            "type": "keyword"
          },
          "obj_type": {
            "type": "keyword"
          },
          "status": {
            "type": "keyword"
          }
        }
      }
    }
  }
}
